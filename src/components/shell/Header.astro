---
import DesktopNav from "../motion/DesktopNav";
import LanguageSwitcher from "./LanguageSwitcher";
import MobileNav from "./MobileNav";
import ThemeToggle from "./ThemeToggle";
import type { Dictionary, Locale } from "@/i18n";
import { getSections, sectionHref, type SectionId } from "@/lib/sections";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;

const sections = getSections(locale);
const homeHash = sections[0]?.hash ?? (locale === "pt" ? "inicio" : "home");
const links = sections.map((section) => ({
  id: section.id as SectionId,
  href: sectionHref(locale, section.hash),
  label: dict.nav[section.id],
}));
---

<header
  class="glass sticky top-0 z-40 border-x-0 border-t-0"
  style="border-radius: 0;"
>
  <div
    class="container-site flex h-16 items-center justify-between gap-4 md:h-[4.25rem]"
  >
    <a
      href={sectionHref(locale, homeHash)}
      data-egg-name
      class="font-display text-lg font-bold tracking-tight text-fg no-underline md:text-xl"
    >
      João Pedro Borges
    </a>

    <DesktopNav client:load links={links} navLabel={dict.a11y.mainNav} />

    <div class="flex items-center gap-1">
      <LanguageSwitcher client:load locale={locale} label={dict.a11y.language} />
      <ThemeToggle
        client:load
        label={dict.a11y.themeToggle}
        labelLight={dict.a11y.switchToLight}
        labelDark={dict.a11y.switchToDark}
      />
      <MobileNav
        client:load
        links={links}
        menuLabel={dict.a11y.mobileNav}
        openLabel={dict.a11y.openMenu}
        closeLabel={dict.a11y.closeMenu}
      />
    </div>
  </div>
</header>
