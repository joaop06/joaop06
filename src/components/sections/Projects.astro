---
import ProjectsList from "../motion/ProjectsList";
import { projects } from "@/data/projects";
import type { Dictionary } from "@/i18n";

interface Props {
  dict: Dictionary;
  hash: string;
}

const { dict, hash } = Astro.props;

const items = projects.map((project) => {
  const copy = dict.projects.items[project.id];
  return {
    id: project.id,
    url: project.url,
    thumb: project.thumb,
    name: copy.name,
    description: copy.description,
    visitLabel: dict.projects.visit,
    externalLabel: dict.a11y.externalLink,
  };
});
---

<section id={hash} class="section-shell" aria-labelledby={`${hash}-heading`}>
  <div class="container-site">
    <h2
      id={`${hash}-heading`}
      class="font-display text-3xl font-bold text-fg md:text-4xl"
    >
      {dict.projects.title}
    </h2>

    <ProjectsList client:visible items={items} />
  </div>
</section>
