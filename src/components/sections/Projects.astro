---
import { getImage } from "astro:assets";
import ProjectsList from "../motion/ProjectsList";
import projectThumb from "@/assets/project-thumb.svg";
import { projects } from "@/data/projects";
import type { Dictionary } from "@/i18n";

interface Props {
  dict: Dictionary;
  hash: string;
}

const { dict, hash } = Astro.props;

/** F5.4 — otimizar thumb uma vez no SSG; island React só recebe URL. */
const thumbOptimized = await getImage({
  src: projectThumb,
  width: 160,
  height: 100,
});

const items = projects.map((project) => {
  const copy = dict.projects.items[project.id];
  return {
    id: project.id,
    url: project.url,
    thumb: thumbOptimized.src,
    thumbWidth: thumbOptimized.attributes.width ?? 160,
    thumbHeight: thumbOptimized.attributes.height ?? 100,
    name: copy.name,
    description: copy.description,
    visitLabel: dict.projects.visit,
    externalLabel: dict.a11y.externalLink,
  };
});
---

<section id={hash} class="section-shell" aria-labelledby={`${hash}-heading`}>
  <div class="container-site">
    <h2
      id={`${hash}-heading`}
      class="font-display text-3xl font-bold text-fg md:text-4xl"
    >
      {dict.projects.title}
    </h2>

    <ProjectsList client:visible items={items} />
  </div>
</section>
