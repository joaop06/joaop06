---
import { ContactForm } from "@/components/forms/ContactForm";
import { contact, whatsappScheduleUrl } from "@/data/contact";
import type { Dictionary } from "@/i18n";

interface Props {
  dict: Dictionary;
  hash: string;
}

const { dict, hash } = Astro.props;
const scheduleHref = whatsappScheduleUrl(dict.hero.whatsappMessage);

const channels = [
  {
    label: dict.contact.email,
    href: `mailto:${contact.email}`,
    value: contact.email,
    external: false,
  },
  {
    label: dict.contact.whatsapp,
    href: contact.whatsappUrl,
    value: contact.phoneDisplay,
    external: true,
  },
  {
    label: dict.contact.instagram,
    href: contact.instagram,
    value: contact.instagramHandle,
    external: true,
  },
  {
    label: dict.contact.linkedin,
    href: contact.linkedin,
    value: "linkedin.com/in/joaop06",
    external: true,
  },
  {
    label: dict.contact.github,
    href: contact.github,
    value: "github.com/joaop06",
    external: true,
  },
] as const;
---

<section id={hash} class="section-shell" aria-labelledby={`${hash}-heading`}>
  <div class="container-site">
    <h2
      id={`${hash}-heading`}
      class="font-display text-3xl font-bold text-fg md:text-4xl"
    >
      {dict.contact.title}
    </h2>
    <p class="mt-3 max-w-prose text-fg-muted">{dict.contact.intro}</p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={`#${hash}`}
        class="inline-flex items-center justify-center rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white no-underline"
      >
        {dict.cta.talk}
      </a>
      <a
        href={scheduleHref}
        target="_blank"
        rel="noopener noreferrer"
        class="glass inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-fg no-underline"
      >
        {dict.cta.schedule}
      </a>
    </div>

    <ul class="mt-10 m-0 grid list-none gap-3 p-0 sm:grid-cols-2">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="block rounded-xl border border-border-glass px-4 py-3 no-underline transition-colors duration-[var(--dur-fast)] hover:bg-accent-soft"
              target={channel.external ? "_blank" : undefined}
              rel={channel.external ? "noopener noreferrer" : undefined}
            >
              <span class="block text-xs font-medium uppercase tracking-wide text-fg-muted">
                {channel.label}
              </span>
              <span class="mt-1 block text-sm text-fg">{channel.value}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <ContactForm client:load labels={dict.contact.form} />
  </div>
</section>
