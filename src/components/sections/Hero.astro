---
import type { Dictionary, Locale } from "@/i18n";
import { contact, whatsappScheduleUrl } from "@/data/contact";
import { sectionHref } from "@/lib/sections";

interface Props {
  locale: Locale;
  dict: Dictionary;
  hashHome: string;
  hashContact: string;
  hashProjects: string;
}

const { locale, dict, hashContact, hashProjects } = Astro.props;

const talkHref = sectionHref(locale, hashContact);
const projectsHref = sectionHref(locale, hashProjects);
const scheduleHref = whatsappScheduleUrl(dict.hero.whatsappMessage);
---

<section
  id={Astro.props.hashHome}
  class="section-shell relative overflow-hidden"
  aria-labelledby="hero-brand"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_20%,var(--accent-soft),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-site grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:gap-12"
  >
    <div class="min-w-0">
      <p class="m-0 text-sm font-medium tracking-wide text-fg-muted">
        {dict.hero.location}
      </p>
      <h1
        id="hero-brand"
        class="font-display mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-5xl md:text-6xl"
      >
        {dict.hero.brand}
      </h1>
      <p
        class="font-mono mt-5 max-w-2xl text-sm leading-relaxed text-fg-muted md:text-base"
      >
        {dict.hero.headline}
      </p>
      <p class="mt-4 max-w-xl text-base text-fg md:text-lg">
        {dict.hero.support}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={talkHref}
          class="inline-flex items-center justify-center rounded-xl bg-accent px-5 py-2.5 text-sm font-medium text-white no-underline transition-opacity duration-[var(--dur-fast)] hover:opacity-90"
        >
          {dict.cta.talk}
        </a>
        <a
          href={projectsHref}
          class="glass inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-fg no-underline transition-colors duration-[var(--dur-fast)] hover:bg-accent-soft"
        >
          {dict.cta.projects}
        </a>
        <a
          href={contact.cvPath}
          download
          class="glass inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-fg no-underline transition-colors duration-[var(--dur-fast)] hover:bg-accent-soft"
        >
          {dict.cta.cv}
        </a>
        <a
          href={scheduleHref}
          target="_blank"
          rel="noopener noreferrer"
          class="glass inline-flex items-center justify-center px-5 py-2.5 text-sm font-medium text-fg no-underline transition-colors duration-[var(--dur-fast)] hover:bg-accent-soft"
        >
          {dict.cta.schedule}
        </a>
      </div>
    </div>

    {/* F2.5 — slot canvas 3D (Fase 4) */}
    <div
      class="glass relative aspect-[4/3] w-full min-h-[220px] overflow-hidden lg:min-h-[320px]"
      role="img"
      aria-label={dict.a11y.heroVisual}
      data-hero-3d-slot
    >
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,color-mix(in_oklab,var(--accent)_28%,transparent),transparent_62%)]"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute left-1/2 top-1/2 size-20 -translate-x-1/2 -translate-y-1/2 rounded-2xl border border-border-glass bg-bg-elevated/80 shadow-[0_8px_32px_var(--glow)]"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute left-[18%] top-[28%] size-3 rounded-md bg-accent/50"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute right-[22%] top-[34%] size-2.5 rounded-md bg-accent/40"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute bottom-[26%] left-[30%] size-2.5 rounded-md bg-accent/35"
        aria-hidden="true"
      >
      </div>
      <div
        class="absolute bottom-[30%] right-[26%] size-3 rounded-md bg-accent/45"
        aria-hidden="true"
      >
      </div>
    </div>
  </div>
</section>
