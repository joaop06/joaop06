---
import HeroCtas from "../motion/HeroCtas";
import HeroScene from "../three/HeroScene";
import type { Dictionary, Locale } from "@/i18n";
import { contact, whatsappScheduleUrl } from "@/data/contact";
import { sectionHref } from "@/lib/sections";

interface Props {
  locale: Locale;
  dict: Dictionary;
  hashHome: string;
  hashContact: string;
  hashProjects: string;
}

const { locale, dict, hashContact, hashProjects } = Astro.props;

const talkHref = sectionHref(locale, hashContact);
const projectsHref = sectionHref(locale, hashProjects);
const scheduleHref = whatsappScheduleUrl(dict.hero.whatsappMessage);

const ctas = [
  {
    href: talkHref,
    label: dict.cta.talk,
    variant: "primary" as const,
    trackId: "talk" as const,
  },
  {
    href: projectsHref,
    label: dict.cta.projects,
    variant: "glass" as const,
    trackId: "projects" as const,
  },
  {
    href: contact.cvPath,
    label: dict.cta.cv,
    variant: "glass" as const,
    download: true,
    trackId: "cv" as const,
  },
  {
    href: scheduleHref,
    label: dict.cta.schedule,
    variant: "glass" as const,
    external: true,
    trackId: "schedule" as const,
  },
];
---

<section
  id={Astro.props.hashHome}
  class="section-shell relative overflow-hidden"
  aria-labelledby="hero-brand"
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_20%,var(--accent-soft),transparent_55%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="container-site relative flex min-h-[min(85vh,52rem)] flex-col justify-center"
  >
    <div class="relative z-10 max-w-xl lg:w-[min(100%,28rem)] xl:w-[min(100%,32rem)]">
      <p class="m-0 text-sm font-medium tracking-wide text-fg-muted">
        {dict.hero.location}
      </p>
      <h1
        id="hero-brand"
        data-egg-name
        class="font-display mt-3 text-4xl font-bold leading-[1.05] tracking-tight text-fg sm:text-5xl md:text-6xl"
      >
        {dict.hero.brand}
      </h1>
      <p
        class="font-mono mt-5 max-w-2xl text-sm leading-relaxed text-fg-muted md:text-base"
      >
        {dict.hero.headline}
      </p>
      <p class="mt-4 max-w-xl text-base text-fg md:text-lg">
        {dict.hero.support}
      </p>

      <HeroCtas client:idle items={ctas} />
    </div>

    {/* F4/F5 — Órbita bleed; idle + import diferido do Three (F5.3) */}
    <div
      class="hero-3d-slot relative mt-8 h-[min(42vh,280px)] w-full lg:absolute lg:inset-y-0 lg:end-0 lg:mt-0 lg:h-auto lg:w-[min(62%,42rem)] xl:w-[min(65%,48rem)]"
      data-hero-3d-slot
    >
      <HeroScene
        client:idle
        label={dict.a11y.heroVisual}
        orbitNodes={dict.hero.orbitNodes}
        dismissLabel={dict.hero.orbitDismiss}
        listLabel={dict.hero.orbitListLabel}
      />
    </div>
  </div>
</section>

<style>
  /* Bleed só em desktop — slot absolute; painel DOM fora da máscara */
  @media (min-width: 1024px) {
    .hero-3d-slot {
      margin-inline-end: -2rem;
    }
  }
</style>
