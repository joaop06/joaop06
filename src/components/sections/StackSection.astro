---
import { TechIcon } from "@/components/ui/TechIcon";
import { stackCategories } from "@/data/stack";
import type { Dictionary } from "@/i18n";

interface Props {
  dict: Dictionary;
  hash: string;
}

const { dict, hash } = Astro.props;
---

<section id={hash} class="section-shell" aria-labelledby={`${hash}-heading`}>
  <div class="container-site">
    <h2
      id={`${hash}-heading`}
      class="font-display text-3xl font-bold text-fg md:text-4xl"
    >
      {dict.stack.title}
    </h2>

    <div class="mt-10 flex flex-col gap-10">
      {
        stackCategories.map((category) => (
          <div>
            <h3 class="font-display m-0 text-lg font-semibold text-fg">
              {dict.stack.categories[category.id]}
            </h3>
            <ul
              class="mt-4 m-0 grid list-none grid-cols-2 gap-3 p-0 sm:grid-cols-3 md:grid-cols-4"
              aria-label={dict.stack.categories[category.id]}
            >
              {category.items.map((item) => {
                const label =
                  dict.stack.items[
                    item.labelKey as keyof typeof dict.stack.items
                  ];
                return (
                  <li
                    data-egg-nest={item.id === "nestjs" ? "" : undefined}
                    class:list={[
                      "flex items-center gap-3 px-3 py-3",
                      item.featured
                        ? "glass border-accent/30 ring-1 ring-accent/25"
                        : "border border-transparent",
                    ]}
                  >
                    {item.icon ? (
                      <TechIcon
                        name={item.icon}
                        title={label}
                        className="size-6 shrink-0 text-fg"
                      />
                    ) : (
                      <span
                        class="flex size-6 shrink-0 items-center justify-center rounded-md bg-accent-soft font-mono text-[10px] font-medium text-accent"
                        aria-hidden="true"
                      >
                        DB
                      </span>
                    )}
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-fg">
                        {label}
                      </span>
                      {item.featured ? (
                        <span class="font-mono text-[10px] uppercase tracking-wide text-accent">
                          {dict.stack.featured}
                        </span>
                      ) : null}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
