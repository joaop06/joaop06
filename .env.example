# Variáveis públicas (expostas no client via import.meta.env)
# Copie para `.env` local / configure no dashboard Vercel. Não commitar secrets
# reais além de IDs públicos Umami.

# URL canônica do site (Vercel)
PUBLIC_SITE_URL=https://joaoborges-dev.vercel.app

# Umami Cloud — preencher no go-live (Fase 7 / P4)
# Sem estes valores o script NÃO é injetado (pageviews ficam desligados).
# Website ID: painel cloud.umami.is → Settings → Tracking code
PUBLIC_UMAMI_WEBSITE_ID=
# Script oficial Cloud (ou proxy próprio):
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
